generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AppConfig {
  key       String   @id
  value     String   @db.Text
  label     String?
  category  String?
  updatedAt DateTime @updatedAt
}

model ReportFormat {
  id          String         @id
  name        String         @db.Text
  description String?
  template    String         @db.Text
  config      Json
  isActive    Boolean        @default(true)
  sessions    RekapSession[]
}

model PriorityLink {
  id          BigInt   @id @default(autoincrement())
  keyword     String   @unique
  description String?  @db.Text
  priority    Int      @default(999)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Operator {
  id        BigInt         @id @default(autoincrement())
  waId      String         @unique
  createdAt DateTime       @default(now())
  sessions  RekapSession[]
}

model RekapSession {
  id          String       @id @default(uuid())
  operatorId  BigInt
  formatId    String
  title       String?      @db.Text
  dateRange   String?
  state       String       @default("draft")
  totalLinks  Int          @default(0)
  summaryJson Json?
  contentDate DateTime?   
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  links       Link[]
  format      ReportFormat @relation(fields: [formatId], references: [id])
  operator    Operator     @relation(fields: [operatorId], references: [id])

  @@index([formatId], map: "RekapSession_formatId_fkey")
  @@index([operatorId], map: "RekapSession_operatorId_fkey")
  @@unique([formatId, title(length: 191)])
  @@index([formatId, contentDate])
}

model Platform {
  id     BigInt @id @default(autoincrement())
  name   String @unique    
  domain Json?
  category String @default("online") // "sosmed" | "online"
  links  Link[]
  shortName String?   
  sortOrder Int    @default(99)
}

model Unit {
  id    BigInt @id @default(autoincrement())
  name  String @unique
  type  String
  links Link[]
  domains Json?
  aliases Json?
  rilisSubmissions RilisSubmission[]
  interaksiStatuses AnggotaInteraksiStatus[]
}

model Link {
  id         BigInt       @id @default(autoincrement())
  url        String       @db.Text
  sessionId  String
  platformId BigInt
  unitId     BigInt?
  isPriority Boolean      @default(false)
  createdAt  DateTime     @default(now())
  platform   Platform     @relation(fields: [platformId], references: [id])
  session    RekapSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  unit       Unit?        @relation(fields: [unitId], references: [id])
  @@index([url(length: 191)])


  @@index([platformId], map: "Link_platformId_fkey")
  @@index([sessionId], map: "Link_sessionId_fkey")
  @@index([unitId], map: "Link_unitId_fkey")
  @@index([sessionId, unitId, platformId]) 
}

model User {
  id        BigInt   @id @default(autoincrement())
  username  String   @unique @db.VarChar(100)
  password  String   @db.Text
  email     String?  @unique @db.VarChar(255)
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BaileysSession {
  id        String   @id
  value     String   @db.Text
  updatedAt DateTime
}

model CustomDocument {
  id        String   @id
  name      String
  paperSize String   @default("f4")
  orient    String   @default("landscape")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model RilisSubmission {
  id          BigInt   @id @default(autoincrement())
  unitId      BigInt
  unit        Unit     @relation(fields: [unitId], references: [id])
  contentDate DateTime          // tengah malam WIB, granularitas hari
  rayon       Int?
  metode String? @db.VarChar(10)  // header | judul | pengirim | manual
  pengirim    String?  @db.VarChar(255)
  fingerprint String   @unique @db.VarChar(64)   // sha256 hex
  createdAt   DateTime @default(now())

  @@index([unitId, contentDate])
  @@index([contentDate])
}

model AnggotaInteraksiStatus {
  id         BigInt   @id @default(autoincrement())
  unitId     BigInt
  unit       Unit     @relation(fields: [unitId], references: [id])
  periode    String   @db.VarChar(7)    // "2026-08"
  status     String   @db.VarChar(10)   // BELUM | SUDAH | TERLAMBAT
  linkDrive  String?  @db.Text
  keterangan String?  @db.VarChar(255)
  updatedAt  DateTime @updatedAt

  @@unique([unitId, periode])
  @@index([periode])
}

// =====================================================================
// MONITORING MEDIA ONLINE & MEDIA SOSIAL
// =====================================================================

model MonitoringKategori {
  id        BigInt   @id @default(autoincrement())
  kode      String   @unique @db.VarChar(40)   // POSITIF_POLRI, PROVOKASI, ...
  nama      String   @db.VarChar(120)          // teks yang dicetak di laporan
  aliases   Json?                              // variasi ejaan/typo saat import
  sortOrder Int                                // 1..11, urutan cetak di laporan
  sentimen  String   @db.VarChar(10)           // POSITIF | NEGATIF | NETRAL
  subjek    String   @db.VarChar(12)           // POLRI | PEMERINTAH | UMUM
  isActive  Boolean  @default(true)

  items MonitoringItem[]
  rules MonitoringRule[]

  @@index([sortOrder])
}

model MonitoringSesi {
  id          String    @id @default(uuid())
  contentDate DateTime                         // tengah malam WIB
  state       String    @default("draft") @db.VarChar(10)  // draft | final
  totalOnline Int       @default(0)
  totalSosmed Int       @default(0)
  summaryJson Json?                            // snapshot count per kategori
  createdAt   DateTime  @default(now())
  finalizedAt DateTime?

  items MonitoringItem[]

  @@unique([contentDate])
}

model MonitoringItem {
  id          BigInt   @id @default(autoincrement())
  sesiId      String
  kanal       String   @db.VarChar(8)          // ONLINE | SOSMED
  kategoriId  BigInt
  judul       String   @db.Text
  url         String   @db.Text
  urlHash     String   @db.VarChar(64)         // sha256 dari url ternormalisasi
  sumber      String?  @db.VarChar(120)        // hostname atau @akun
  platformId  BigInt?                          // sengaja tanpa relasi, lihat catatan
  isuId       BigInt?                          // hasil klaster isu, nullable
  sumberInput String   @db.VarChar(10)         // MANUAL | PASTE | IMPORT | CRAWLER
  confidence  Int?                             // 0-100 skor auto-klasifikasi
  isReviewed  Boolean  @default(false)
  urutan      Int      @default(0)
  createdAt   DateTime @default(now())

  sesi     MonitoringSesi     @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  kategori MonitoringKategori @relation(fields: [kategoriId], references: [id])
  isu      MonitoringIsu?     @relation(fields: [isuId], references: [id], onDelete: SetNull)

  @@unique([sesiId, urlHash])
  @@index([sesiId, kanal, kategoriId])
  @@index([kategoriId])
  @@index([urlHash])
  @@index([isuId])
  @@index([sumber])
}

model MonitoringIsu {
  id            BigInt   @id @default(autoincrement())
  judul         String   @db.Text              // diambil dari item pertama
  tokenJson     Json                           // token judul, buat cocokkan lintas hari
  firstDate     DateTime                       // tengah malam WIB
  lastDate      DateTime
  totalItem     Int      @default(0)
  totalOnline   Int      @default(0)
  totalSosmed   Int      @default(0)
  kategoriCount Int      @default(1)           // >1 berarti framing terbelah
  hitungPerHari Json?                          // { "2026-05-19": 2, ... }
  skor          Int      @default(0)
  updatedAt     DateTime @updatedAt

  items MonitoringItem[]

  @@index([lastDate, skor])
  @@index([firstDate])
}

model MonitoringRule {
  id         BigInt  @id @default(autoincrement())
  keyword    String  @db.VarChar(80)
  kategoriId BigInt
  kanal      String? @db.VarChar(8)            // null = berlaku dua kanal
  bobot      Int     @default(10)
  isActive   Boolean @default(true)

  kategori MonitoringKategori @relation(fields: [kategoriId], references: [id])

  @@index([kategoriId])
  @@index([isActive])
}

model MonitoringSumber {
  id         BigInt    @id @default(autoincrement())
  nama       String    @db.VarChar(120)
  jenis      String    @db.VarChar(12)         // RSS | GNEWS | IG
  alamat     String    @db.Text                // url feed, query, atau username
  domain     String?   @db.VarChar(120)
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  lastStatus String?   @db.VarChar(200)

  kandidat MonitoringKandidat[]

  @@index([isActive, jenis])
}

model MonitoringKandidat {
  id         BigInt    @id @default(autoincrement())
  sumberId   BigInt
  judul      String    @db.Text
  url        String    @db.Text
  urlHash    String    @unique @db.VarChar(64)
  terbitAt   DateTime?
  kanal      String    @db.VarChar(8)          // ONLINE | SOSMED
  sumberNama String?   @db.VarChar(120)        // hostname hasil resolve
  saranKode  String?   @db.VarChar(40)         // kode kategori hasil rule
  confidence Int?
  status     String    @default("baru") @db.VarChar(10)  // baru | diambil | ditolak
  createdAt  DateTime  @default(now())

  sumber MonitoringSumber @relation(fields: [sumberId], references: [id], onDelete: Cascade)

  @@index([status, terbitAt])
  @@index([sumberId])
}

model MonitoringDomain {
  id          BigInt   @id @default(autoincrement())
  domain      String   @unique @db.VarChar(120)
  kanal       String   @db.VarChar(8)          // ONLINE | SOSMED
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  totalItem   Int      @default(0)
  punyaFeed   Boolean  @default(false)

  @@index([kanal, totalItem])
  @@index([firstSeenAt])
}